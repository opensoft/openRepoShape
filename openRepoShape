#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# openRepoShape — the short way in: `openRepoShape Atlas --org <your-org>`.
#
# Install it once, from anywhere, with no checkout and no clone. The newest
# release, pinned to its tag (`install.sh`, #564):
#
#   curl -fsSL https://github.com/opensoft/openRepoShape/releases/latest/download/install.sh | bash
#
# Or this file at main, by hand, which follows main:
#
#   gh api repos/opensoft/openRepoShape/contents/openRepoShape \
#       -H 'Accept: application/vnd.github.raw' | bash -s -- --install
#
# (or the raw-URL twin, `curl -fsSL …/main/openRepoShape | bash -s -- --install`).
#
# IT ADDS NO BEHAVIOUR: it fetches `setup.sh` from opensoft/openRepoShape and
# runs it, turning the positional <Project> into `--project <Project>` and
# passing every other argument through untouched. The README's long
# `curl … | bash -s -- --org … --project …` line and this do the same thing.
#
# `--install` PLACES ONE COMMAND: this file. `park` and `resume` were placed
# beside it until 2026-09-10 and are opensoft/openRepoTools' now (#92), with an
# installer of their own — which this one PRINTS and never runs. A command that
# reached into another repository to finish its own install would make the
# standard depend on its tools at runtime, and that is the direction the carve
# exists to forbid: tools depend on the shape, the shape depends on nothing.

set -euo pipefail

# $OPENREPOSHAPE_REPO is an owner/name slug here (it is an API path), while
# setup.sh reads the same variable as something to `git clone` — see
# shape_clone_url below: one name, both uses.
REPO="${OPENREPOSHAPE_REPO:-opensoft/openRepoShape}"
SELF="${BASH_SOURCE[0]:-$0}"

# THE REF, AND WHETHER IT WAS NAMED (#564). A NAMED ref is one somebody
# chose: setup.sh is told it (`--shape-ref`) and `--doctor` checks its clone
# out at it, where an unnamed `main` leaves both to the default branch. Two
# things name one, and the first wins: `$OPENREPOSHAPE_REF`, set for a run,
# and the ref `--install` RECORDED beside this file (`<file>.ref`, read by
# `read_recorded_ref` below, once `ref_fault` exists to check it). With
# neither, it is `main`, unnamed, exactly as before there was a record.
REF="${OPENREPOSHAPE_REF:-main}"
REF_NAMED=0
[ -z "${OPENREPOSHAPE_REF:-}" ] || REF_NAMED=1

#: 1 when the ref in force came from the record, which is what lets a
#: command re-installing itself keep it with no opt-in (see `record_ref`).
REF_FROM_RECORD=0

#: Why the record beside this file was refused, said once the arguments are
#: read, so that `--help` still answers past a broken record.
RECORD_FAULT=""

#: The record's name is the command's own plus this, so the record of
#: `~/.local/bin/openRepoShape` is `~/.local/bin/openRepoShape.ref`.
RECORD_SUFFIX=".ref"

PROJECT=""
ORG=""
MODE="run"
PREFLIGHT=0
DOCTOR_PATH=""
DOCTOR_PATH_GIVEN=0
# `shape-doctor.py`'s own two flags, as `--doctor` hands them on (#500).
DOCTOR_ARGS=()
DOCTOR_JSON=0
PLAN_FILE=""
PASSTHROUGH=()
WORKDIR=""
STAGED=""

say() { printf '%s\n' "$*"; }

# One mode per run. See the `--install` case for why this refuses instead of
# taking the last one typed.
set_mode() {
	[ "$MODE" = "run" ] || [ "$MODE" = "$1" ] ||
		die "--$MODE and --$1 are two different runs; pass one.
    --install places this command, --doctor reads a repository and writes nothing."
	MODE="$1"
}
die() { printf '\nREFUSED: %s\n' "$1" >&2; exit "${2:-2}"; }

usage() {
	cat <<'USAGE'
openRepoShape --install            install (or update) this command into ~/.local/bin
openRepoShape --preflight          check this MACHINE and stop; creates nothing
openRepoShape --doctor [<path>] [--json] [--placement-plan <file>]
openRepoShape <Project> [--org <org>] [setup-project.py options] [-- <scaffold flags>]
openRepoShape --help | --version

Those four lines are the whole command: install it, check the machine you are
on, diagnose a repository, scaffold a project. Run with NO arguments it prints
this and exits 1, because a bare run has nothing to do.

<Project> is the assembly-root name, ONE CamelCase token (e.g. Atlas); omit it
and setup.sh asks, if a terminal is attached. `--org` comes from that flag,
else $OPENREPOSHAPE_ORG, else a prompt — it is NEVER defaulted. Every other
argument reaches setup.sh unchanged: --visibility, --elected-by, --family,
--into, --yes, --local-remote-dir, and anything after `--`, which setup.sh
hands on to scaffold-project.py. They are setup-project.py's flags:
`python3 setup-project.py --help` lists them all, and so does
`./setup.sh --help` in a checkout of this standard.

`--install` places ONE command, and it is this one file:

  openRepoShape <Project> --org <org>    scaffold a project

The estate verbs are not here. `park` and `resume` — commit, push and RECORD an
estate's open features, then rebuild them on the next workstation — are
opensoft/openRepoTools', and its own installer places them:

  curl -fsSL https://raw.githubusercontent.com/opensoft/openRepoTools/main/openRepoTools | bash -s -- --install

  $OPENREPOSHAPE_REPO       owner/name to fetch from (default opensoft/openRepoShape)
  $OPENREPOSHAPE_REF        the ref to fetch it at   (default: the ref --install
                            recorded, else main)
  $OPENREPOSHAPE_ORG        the organisation, when --org is not given
  $OPENREPOSHAPE_BIN_DIR    where --install puts it  (default ~/.local/bin)
  $OPENREPOSHAPE_SETUP_SH   run this setup.sh on disk instead of fetching one
  $OPENREPOSHAPE_RECORD_REF 1: --install records $OPENREPOSHAPE_REF (below)

`--install` RECORDS A REF ONLY WHEN ASKED: with $OPENREPOSHAPE_RECORD_REF=1
it writes $OPENREPOSHAPE_REF to `openRepoShape.ref` beside the command it
places, which is what the one-line installer (install.sh) does with the
release tag it installs. The installed command then stays on that ref: it
fetches setup.sh at it, setup.sh clones the standard at it (`--shape-ref`),
and `--doctor` checks its clone out at it. $OPENREPOSHAPE_REF set for one run
still wins, and `--version` prints the ref in force. A command re-installing
itself keeps its own record; any other install records nothing, removes a
record already there, and follows main.

`--doctor [<path>] [--json] [--placement-plan <file>]` runs `shape-doctor.py`
over <path> (default `.`) and prints one row per check and ONE verdict:
`COMPLIANT`, `COMPLIANT, SHAPE BEHIND`, `DRIFTED`, `MISPLACED`, `INVALID`,
`NOT A SHAPE ROOT` or `CANNOT ANSWER`. Every finding names the command that
fixes it. Exit 0 compliant, 1 findings, 2 not a shape root, 3 when it cannot
answer (`CANNOT ANSWER`, no such <path>, a `--placement-plan` it cannot
write); this command's own refusals exit 2. `--json` is the same report as
one JSON object. The doctor writes no file but the `--placement-plan <file>`
you name, at the path you give (a relative <file> lands in the directory you
ran this from, even inside the repository), and moves nothing.

Run beside a checkout of the standard, it uses that one. Run from anywhere
else, it clones the standard into a temporary directory first and KEEPS it,
because its NEXT lines name files in it. The report's last line names
that directory, which is safe to delete once you are done with those
commands; under `--json` that line goes to stderr, so stdout stays one JSON
object.

`--preflight` is the MACHINE check -- it was spelled `--doctor` until
2026-09-10, and the name moved to the repository diagnosis above, which is
what a person means by a doctor.
USAGE
}

# THE TRAP BELONGS TO THE SHELL THAT DOES THE WRITING, so this makes the
# directory and takes no output. It used to `printf` the path and every
# caller read it as `$(workdir)` — a command substitution, which is a
# SUBSHELL: `trap … EXIT` set in there is the SUBSHELL's trap and fires the
# instant the substitution closes, so `rm -rf` ran before a single fetched
# byte had landed in the directory, and $WORKDIR out here was still empty.
# A trap only ever fires in the shell that set it. Callers read $WORKDIR.
#
# A NAME, WHEN ONE IS GIVEN, IS FOR A DIRECTORY THAT OUTLIVES THE RUN (#500).
# `--doctor` keeps its clone of the standard, because the NEXT lines it
# prints name files in there, so the directory carries the name of what
# made it: `ls "$TMPDIR"/openRepoShape-doctor.*` finds every one a person has
# been left, where `tmp.*` would be anybody's. The template form is the one
# GNU and BSD `mktemp` both read. It is RESOLVED, `pwd -P`, because the
# doctor prints its standard resolved, and on macOS `$TMPDIR` sits under the
# `/var` -> `/private/var` link: the report's first and last lines would
# otherwise name one directory two ways.
#
# EVERY STEP OF THAT IS CHECKED, because `--doctor` runs this under `set +e`
# and the trap below removes whatever $WORKDIR holds. A failed `mktemp`
# followed by an unchecked `cd -- ""` would leave `pwd -P` printing the
# directory the person is standing in, and the trap would remove THAT.
workdir() {
	local base made
	if [ -z "$WORKDIR" ]; then
		if [ -n "${1:-}" ]; then
			base="${TMPDIR:-/tmp}"
			made="$(mktemp -d "${base%/}/$1.XXXXXXXX")" &&
				made="$(cd -- "$made" && pwd -P)" && [ -n "$made" ] ||
				die "could not make a temporary directory under $base. Set \$TMPDIR to a directory you can write to."
			WORKDIR="$made"
		else
			WORKDIR="$(mktemp -d)"
		fi
		trap 'rm -rf -- "$WORKDIR"' EXIT
	fi
}

# THE API FIRST, the raw URL second. `gh api` is authenticated, so it still
# works inside an organisation whose policy blocks raw.githubusercontent.com;
# curl is the fallback for a machine with no `gh`. Each attempt writes to a
# file and is checked before its bytes are used, so a half-written first
# attempt is never mistaken for a fetch.
#
# HTTPS ONLY, REDIRECTS INCLUDED, TLS 1.2 OR NEWER (#564, SonarCloud
# shell:S6506): the flags are written out on the curl line itself, never
# gathered into an array, so a reader and the analyser both see them there.
fetch_from_repo() {
	local path="$1" dest="$2"
	if command -v gh >/dev/null 2>&1 &&
		gh api "repos/$REPO/contents/$path?ref=$REF" \
			-H 'Accept: application/vnd.github.raw' >"$dest" 2>/dev/null &&
		[ -s "$dest" ]; then
		return 0
	fi
	if command -v curl >/dev/null 2>&1 &&
		curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 \
			"https://raw.githubusercontent.com/$REPO/$REF/$path" \
			>"$dest" 2>/dev/null && [ -s "$dest" ]; then
		return 0
	fi
	# RETURNS rather than dying, so a caller fetching SEVERAL files can report
	# the whole set instead of stopping mid-way through an install (#82, F10 of
	# the review on #83). `fetch_or_die` is the one-file spelling.
	return 1
}

fetch_or_die() {
	fetch_from_repo "$1" "$2" || die "could not fetch $1 from $REPO at $REF. Both ways failed:
    gh api repos/$REPO/contents/$1?ref=$REF
    curl -fsSL https://raw.githubusercontent.com/$REPO/$REF/$1"
}

# setup.sh CLONES $OPENREPOSHAPE_REPO when it self-bootstraps, so the child is
# handed the clone URL of the very repository these bytes came from: name a
# fork or mirror once and it is used for the fetch AND the clone. A URL or a
# path on disk (what the tests point it at) goes through untouched.
shape_clone_url() {
	case "$REPO" in
	*://* | *@*:* | /* | .*) printf '%s' "$REPO" ;;
	*) printf 'https://github.com/%s.git' "$REPO" ;;
	esac
}

# WHAT `--install` PLACES. One list, so the installer, the fetch fallback and
# the tests cannot disagree about what a complete install is. It held three
# names from #82 until 2026-09-10 and holds one again (#92): `park` and
# `resume` are opensoft/openRepoTools'.
INSTALLABLES=(openRepoShape)

#: WHAT `--doctor` RUNS, named once so the two places that reach for it -- the
#: "is there a checkout beside me" probe and the run itself -- cannot come to
#: disagree about the filename.
DOCTOR="shape-doctor.py"

# EVERY ONE IN HAND BEFORE ANY OF THEM IS PLACED (#82, F10 of the review on
# #83). One file at a time, dying on the first fetch that failed, left a
# person with a NEW `openRepoShape` and no `park` — a half-install that says
# `installed at` and is not one — and there was nothing on screen to say which
# files were missing. Now every one is collected into the temporary directory
# first: a failure there replaces NOTHING, names what was not fetched, and
# exits.
#
# KEPT WHOLE AT ONE INSTALLABLE (#92). The guarantee is a property of the
# STRUCTURE and not of the count, and an installer that holds it only while
# the list is long is an installer that loses it the next time somebody
# shortens the list — which is this commit.
collect_commands() {
	local name selfdir="" missing=""
	# Run from a file, install THOSE bytes: `--install` then needs no network
	# and no `gh` at all, and a name in $INSTALLABLES that is not beside this
	# file is fetched instead. Run from stdin (`curl … | bash -s -- --install`)
	# there is no file to copy from at all, so every one of them is fetched at
	# this same ref.
	if [ -f "$SELF" ]; then
		selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	fi
	workdir
	STAGED="$WORKDIR/staged"
	mkdir -p "$STAGED"
	for name in "${INSTALLABLES[@]}"; do
		if [ -n "$selfdir" ] && [ -f "$selfdir/$name" ]; then
			cp -- "$selfdir/$name" "$STAGED/$name"
			continue
		fi
		fetch_from_repo "$name" "$STAGED/$name" ||
			missing="${missing:+$missing }$name"
	done
	[ -z "$missing" ] || die "could not fetch $missing from $REPO at $REF, so NOTHING was installed
    and nothing already installed was replaced. \`--install\` places every one
    of the ${#INSTALLABLES[@]} it collects or none of them: a new command beside a missing
    one is a half-install that reads like a whole one. Both ways were tried:
    gh api repos/$REPO/contents/<file>?ref=$REF
    curl -fsSL https://raw.githubusercontent.com/$REPO/$REF/<file>"
}

# THE MACHINE, READ ONLY, AS THE LAST THING `--install` SAYS. Somebody who
# has just placed this command is about to use it, and these are the four
# things it will then want: `git`, `gh` and whether it is logged in, a
# `python3`, and `git-filter-repo` -- which only `adopt-project.py` needs and
# `--preflight` therefore does not ask about.
#
# IT OFFERS NOTHING AND RUNS NO INSTALLER. Four `command -v` probes, which
# execute nothing at all, and one `gh auth status`, which is the only way to
# learn a login state. An offer belongs behind a typed yes, in `--preflight`,
# and this line points there rather than growing a second consent.
#
# IT NEVER CHANGES THE EXIT CODE. A machine missing a prerequisite did not
# make the copy that was just placed any less placed, and an install that
# reported failure because `gh` was not logged in would be an install nobody
# could script.
machine_report() {
	local name state short=0
	say "  machine:"
	for name in git gh python3 git-filter-repo; do
		if command -v "$name" >/dev/null 2>&1; then
			state="present"
			if [ "$name" = gh ]; then
				if gh auth status >/dev/null 2>&1; then
					state="present, logged in"
				else
					state="present, not logged in"
					short=1
				fi
			fi
		else
			state="MISSING"
			short=1
		fi
		printf '    %-16s %s\n' "$name" "$state"
	done
	[ "$short" -eq 0 ] ||
		say "  run: openRepoShape --preflight   (offers what is missing; each install asks first)"
}

# THE REF THIS INSTALL RAN AT, WRITTEN BESIDE THE COMMAND IT PLACED (#564).
# Without it an installed command read `$OPENREPOSHAPE_REF` at every run and
# fell back to `main`, so a command installed from a release fetched the next
# day's main: the release it was installed from lasted until main moved.
#
# A FILE BESIDE THE COMMAND, NEVER AN EDIT TO IT. The placed command stays
# byte for byte the file it was installed from, so `cmp` against the release's
# own `openRepoShape` still says whether it IS that release: the `(unchanged)`
# verdict `install_commands` gives, and any copy vendored and checked by
# sha256 elsewhere, compare the command's bytes and never see the record. A
# command copied away without its record follows `main` again, and says so in
# `--version`.
#
# RECORDED ONLY WHEN ASKED (#564, the review on #577). `$OPENREPOSHAPE_REF`
# alone records nothing, because a script that sets it around `--install`
# for its own reasons is not asking for a pin: workBenches sets it to a value
# that names no ref at all, to make any fetch fail loudly, and a record of
# that would break every later run on every machine it installs to. So the
# ref in force is written only when `$OPENREPOSHAPE_RECORD_REF` is 1, as the
# one-line installer sets it, or when it came from the record beside the copy
# being run, so a pinned command re-installing itself stays pinned. Any other
# install is an install with no ref: it records nothing, and REMOVES a record
# already there, which makes an install at main follow main however the
# command was installed before. Every outcome is one line, and nothing to
# record and no record is no line at all. The record's old value is echoed
# only when it is a ref this command would accept, because a hand-edited
# file is not this command's to print.
record_ref() {
	local record="$1" recording="$2" was=""
	if [ -f "$record" ]; then
		was="$(< "$record")" || was=""
		[ -z "$(ref_fault "$was" "it")" ] || was="another ref"
	fi
	if [ "$recording" -eq 0 ]; then
		[ -e "$record" ] || return 0
		rm -f -- "$record"
		say "openRepoShape: no longer pinned to ${was:-another ref}; it follows main, or \$OPENREPOSHAPE_REF where set (removed $record)"
	elif [ "$was" = "$REF" ]; then
		say "openRepoShape: already pinned to $REF in $record (unchanged)"
	else
		printf '%s\n' "$REF" >"$record"
		say "openRepoShape: pinned to $REF${was:+ (was $was)}, recorded in $record"
	fi
}

install_commands() {
	local dir="${OPENREPOSHAPE_BIN_DIR:-$HOME/.local/bin}"
	local name target source verb placed=0 recording=0 record
	if [ "$REF_FROM_RECORD" -eq 1 ] ||
		{ [ "$REF_NAMED" -eq 1 ] && [ "${OPENREPOSHAPE_RECORD_REF:-}" = 1 ]; }; then
		recording=1
	fi
	# THE RECORD SITS BESIDE THE FILE, symlinks followed, as it is read.
	record="$(resolved "$dir/openRepoShape")$RECORD_SUFFIX"
	# BOTH CHECKED BEFORE ANYTHING IS COLLECTED OR PLACED: a ref about to be
	# written down and read back by every later run, and a record path this
	# install could neither write nor remove. A refusal after the copy would
	# leave a new command beside an old record.
	[ "$recording" -eq 0 ] || checked_ref "$REF"
	[ ! -e "$record" ] || [ -f "$record" ] ||
		die "$record is not a file, so this install could neither record its ref there nor remove it. Move it away, then run this again."
	collect_commands
	mkdir -p "$dir"
	for name in "${INSTALLABLES[@]}"; do
		source="$STAGED/$name"
		target="$dir/$name"
		if [ -e "$target" ] && cmp -s "$source" "$target"; then
			verb="already installed at $target (unchanged)"
		else
			if [ -e "$target" ]; then verb="updated at $target"; else verb="installed at $target"; fi
			cp -- "$source" "$target"
		fi
		# Stamped every time: a copy that is not executable is not a command.
		chmod 755 "$target"
		placed=$((placed + 1))
		say "$name: $verb"
	done
	# The record belongs to the one command that reads it, and is written
	# only once that command is in place.
	record_ref "$record" "$recording"
	# THE COUNT, out loud, and kept at one installable (#92): it costs a line
	# and is what keeps $INSTALLABLES honest — a person reading N lines cannot
	# tell whether an N+1th was meant to be there. The sentence that made
	# `--install` plural is the pointer's job now.
	say "openRepoShape: $placed of ${#INSTALLABLES[@]} placed in $dir"
	# THE POINTER, unconditional and TEXT ONLY (#92). Nothing here is fetched
	# from opensoft/openRepoTools and nothing checks whether its installer has
	# been run: this command reports where the estate verbs come from and stops
	# there. The `curl` line is byte-identical to the one README.md carries,
	# and `tests/test_repo_hygiene.py` is what holds the copies together.
	say "  park and resume are installed by openRepoTools, not by this command:"
	say "    curl -fsSL https://raw.githubusercontent.com/opensoft/openRepoTools/main/openRepoTools | bash -s -- --install"
	# THE PATH NOTE, last, and it is about the directory THIS command just
	# wrote to — `$OPENREPOSHAPE_BIN_DIR`, nothing else. openRepoTools reads
	# its own `$OPENREPOTOOLS_BIN_DIR` and defaults to the same
	# `~/.local/bin`, so the two land together on a machine that sets
	# neither and in two places on a machine that sets one.
	case ":${PATH:-}:" in
	*":$dir:"*) ;;
	*)
		say "  $dir is not on \$PATH. Add it:"
		say "    export PATH=\"$dir:\$PATH\""
		;;
	esac
	# LAST, because it is about the NEXT command rather than about this one.
	machine_report
}

# A PYTHON, BY THE SAME RULE `setup.sh` FINDS ONE BY: 3.9 or newer, under
# whichever name this machine has it. Transcribed rather than shared because
# these two files are never both on disk in the installed case -- this one is
# a single file in ~/.local/bin -- and `--doctor` must work there.
find_python() {
	local candidate
	for candidate in python3 python; do
		if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c \
			'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' \
			>/dev/null 2>&1; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	return 1
}

# A CHECKOUT OF THE STANDARD, made the way `setup.sh` self-bootstraps one:
# `git clone` of `shape_clone_url`, into the temporary directory `workdir`
# owns, checked out at $REF when one was named: by $OPENREPOSHAPE_REF, or by
# the record `--install` left beside this file (#564). Sets $SHAPE_DIR.
#
# WITHOUT `--depth 1`, WHICH IS THE ONE DEVIATION FROM setup.sh AND IS FORCED.
# A shallow clone has exactly ONE commit, and the doctor's shape-currency row
# compares a project's copies at the commit its pin NAMES against this
# standard's tip -- a comparison a one-commit history cannot make at all. The
# scaffold has no such need, so it stays shallow and this does not.
#
# The guard on $SHAPE_REPO is `setup.sh`'s, for its reason: the value reaches
# a `git clone` command line, where a leading `-` is an option rather than a
# repository and a control character could forge a line of output before this
# script has said a word. The refusal does not echo the value back.
shape_checkout() {
	local url
	url="$(shape_clone_url)"
	case "$url" in
	-* | *[![:print:]]*) die "OPENREPOSHAPE_REPO is not a value this tool will put on a \`git clone\` command line: it starts with '-' or carries a control character. Set it to a URL or a path." ;;
	esac
	workdir openRepoShape-doctor
	SHAPE_DIR="$WORKDIR/shape"
	git clone --quiet -- "$url" "$SHAPE_DIR" ||
		die "could not clone $REPO into a temporary directory, so there is no
    standard to check against. \`--doctor\` needs one: run it from a checkout
    of openRepoShape, or make the clone work."
	if [ "$REF_NAMED" -eq 1 ]; then
		checked_ref "$REF"
		# `<ref> --`, never `-- <ref>`: a `--` BEFORE the argument makes git
		# read it as a PATHSPEC and try to restore a file of that name from
		# the index. AFTER it, it says "and no paths follow", which is the
		# disambiguation this wants. The leading-dash case is refused by
		# `checked_ref` above, which is where it belongs.
		git -C "$SHAPE_DIR" checkout --quiet "$REF" -- ||
			die "cloned $REPO but could not check out '$REF'."
	fi
}

# `setup.sh`'s THREE CHECKS ON A REF, IN ITS ORDER, and the order is the
# point (Copilot, PR #96: this value reaches `git checkout`, where a leading
# dash is an option rather than a ref). LENGTH first, so an over-long value
# is refused without putting 255+ characters of noise on stderr; a CONTROL
# CHARACTER next, because a newline in it could forge a line of output before
# this script has said a word; and only then the SHAPE, which is safe to echo
# back because it has passed both.
#
# WHOSE REF IT IS IS AN ARGUMENT (#564): `$OPENREPOSHAPE_REF` by default, or
# the record `--install` wrote. `ref_fault` SAYS what is wrong and refuses
# nothing, so the record can be checked as it is read and refused only once
# the arguments are, after `--help` has had its chance; `checked_ref` is the
# refusing spelling. An EMPTY ref is a fault too, which no caller could reach
# before the record: an empty variable is no ref at all, while an empty file
# is one.
ref_fault() {
	local ref="$1" what="$2"
	if [ -z "$ref" ]; then
		printf '%s' "$what is empty, which is not a branch, tag or commit this tool will pass to \`git checkout\`."
	elif [ "${#ref}" -gt 255 ]; then
		printf '%s' "$what is ${#ref} characters long; a branch, tag or commit this tool will pass to \`git checkout\` is at most 255 characters."
	else
		case "$ref" in
		*[![:print:]]*) printf '%s' "$what carries a control character, which is not a branch, tag or commit this tool will pass to \`git checkout\`." ;;
		[!A-Za-z0-9]* | *..* | *.lock | *[!A-Za-z0-9._/-]*) printf '%s' "$what is '$ref', which is not a branch, tag or commit this tool will pass to \`git checkout\`: a ref starts with a letter or digit, uses only letters, digits, '.', '_', '/', '-', has no '..' and does not end in '.lock'." ;;
		esac
	fi
}

checked_ref() {
	local fault
	fault="$(ref_fault "$1" "${2:-\$OPENREPOSHAPE_REF}")"
	[ -z "$fault" ] || die "$fault"
}

# A PATH WITH ITS SYMLINKS FOLLOWED (#564, the review on #577). The record
# sits beside the FILE `--install` placed, so a link to the command from
# anywhere else (`~/bin/openRepoShape -> ~/.local/bin/openRepoShape`) must
# read the record there, not look for one beside the link. `readlink` with
# no `-f`, which macOS before 12.3 lacks, one link at a time and at most 40
# of them, the kernel's own limit, so a loop of links ends. Where `readlink`
# fails or is missing the path is used as it is, which is where the record
# was looked for before. Git Bash makes copies for `ln -s` unless told
# otherwise, and a copy is no link.
resolved() {
	local path="$1" link hops=0
	while [ -L "$path" ] && [ "$hops" -lt 40 ]; do
		link="$(readlink -- "$path" 2>/dev/null)" && [ -n "$link" ] || break
		case "$link" in
		/*) path="$link" ;;
		*) path="$(dirname -- "$path")/$link" ;;
		esac
		hops=$((hops + 1))
	done
	printf '%s' "$path"
}

# THE RECORD `--install` LEFT BESIDE THIS FILE, READ ONCE, BEFORE ANY RUN
# (#564). Only when no `$OPENREPOSHAPE_REF` was set, which is what lets that
# variable win for a run, and only beside a FILE: a script arriving on stdin
# has no place of its own to have been installed at. CHECKED HERE, as it is
# read, rather than where the ref is used: it is a file on disk that every run
# reads, `--version` prints it, and a value nobody typed is not echoed until
# it has passed. A record that fails is NOT refused here but kept in
# `$RECORD_FAULT`, and `refuse_bad_record` refuses with it once the arguments
# have been read: `--help` answers past a broken record, and every run that
# would use the ref refuses, `--version` first. `$(< file)` is bash's own
# read, so no `cat` is needed; a record that is not a readable FILE (a
# directory, say) is a fault in the same words as the rest, never a raw bash
# error.
RECORD_WAY_OUT="Run the installer again to record a release, or delete that file to follow main."
read_recorded_ref() {
	local record text fault
	[ "$REF_NAMED" -eq 0 ] && [ -f "$SELF" ] || return 0
	record="$(resolved "$SELF")$RECORD_SUFFIX"
	[ -e "$record" ] || return 0
	if [ ! -f "$record" ] || [ ! -r "$record" ]; then
		RECORD_FAULT="$record is not a file this command can read, so it cannot read the ref \`--install\` recorded there. Remove it, then run the installer again to record a release, or leave it removed to follow main."
		return 0
	fi
	text="$(< "$record")"
	fault="$(ref_fault "$text" "the ref recorded in $record")"
	if [ -n "$fault" ]; then
		RECORD_FAULT="$fault $RECORD_WAY_OUT"
		return 0
	fi
	REF="$text"
	REF_NAMED=1
	REF_FROM_RECORD=1
}
read_recorded_ref

refuse_bad_record() {
	[ -z "$RECORD_FAULT" ] || die "$RECORD_FAULT"
}

# `--doctor`: RUN THE STANDARD'S OWN SCRIPT, never a reimplementation here.
# Beside a checkout -- this file sitting in one, which is how a developer runs
# it -- that checkout answers, and nothing is fetched at all. Installed, or
# arriving on stdin, there is no checkout beside this file and one is cloned:
# the doctor compares a project's copies against a standard, so it must have
# a standard, and a single file in ~/.local/bin is not one.
run_doctor() {
	local py selfdir="" shape="" cloned=0 kept
	py="$(find_python)" || die "no Python 3.9 or newer on this machine (tried python3, python). \`--doctor\` is a Python program: https://www.python.org/downloads/"
	if [ -f "$SELF" ]; then
		selfdir="$(cd -- "$(dirname -- "$SELF")" && pwd)"
	fi
	if [ -n "$selfdir" ] && [ -f "$selfdir/$DOCTOR" ]; then
		shape="$selfdir"
	else
		command -v git >/dev/null 2>&1 ||
			die "git is not installed, and with no checkout of the standard beside this command there is nothing to clone one with. Install it: https://git-scm.com/downloads"
		shape_checkout
		shape="$SHAPE_DIR"
		cloned=1
	fi
	# NAMED, RATHER THAN LEFT TO THE INTERPRETER. A checkout at a ref older
	# than the doctor — or a fork that does not carry it — produces a
	# `can't open file` from python3 and a stack of nothing useful. The ref
	# is the thing to change, so the refusal says so.
	[ -f "$shape/$DOCTOR" ] ||
		die "$shape has no $DOCTOR, so there is nothing to run. That checkout is $REPO at $REF.
    Set \$OPENREPOSHAPE_REF to a ref that carries it, or run this from a checkout of the standard."
	# RUN, never `exec`: the EXIT trap that removes a cloned checkout belongs
	# to THIS process, and exec would replace the shell that owes it -- and
	# the line below, which names a kept clone, is this shell's to print.
	#
	# IN THE PERSON'S OWN DIRECTORY, never `cd`'d anywhere: that is what
	# resolves a relative `--root` and a relative `--placement-plan <file>`
	# against where they typed the command, exactly as `./shape-doctor.py`
	# would from a checkout, and never against the clone (#500).
	set +e
	"$py" "$shape/$DOCTOR" --root "${DOCTOR_PATH:-.}" \
		${DOCTOR_ARGS[@]+"${DOCTOR_ARGS[@]}"}
	STATUS=$?
	set -e
	# THE CLONE IS KEPT, AND SAID SO LAST (#500; Brett Heap, 2026-10-13:
	# "Keep the run's clone"). The NEXT lines the doctor prints name files in
	# the standard it ran from -- `update-shape.py check --upstream
	# <standard>`, `adopt-project.py plan`, `setup-project.py --preflight`,
	# the template validators -- and the EXIT trap used to remove that
	# standard as this command returned, so each one, pasted, died with
	# `can't open file`. A fix that names a file nobody has is no fix.
	#
	# DISARMED HERE, ONCE THE DOCTOR HAS RUN, AND NOT BEFORE. A refusal on
	# the way here (the clone failed, the ref did not check out, the ref
	# carries no doctor) printed no NEXT line, and a run interrupted mid-way
	# (bash runs the EXIT trap on INT, TERM and HUP too) printed no report;
	# both leave nothing behind, as before. Beside a checkout nothing was
	# cloned, so there is nothing to keep or to name.
	#
	# ON STDERR UNDER `--json`, on stdout otherwise. The JSON object on
	# stdout is a contract a caller parses whole, and one line after it is a
	# document `json.load` refuses; that object already names the clone, as
	# `standard`, and its rows' `next` commands name files in it. A person at a
	# terminal reads stderr as well, which is where this command's REFUSED
	# lines already go. Without `--json` the line is the report's own last
	# line, so a report saved to a file still says what it left behind.
	#
	# IT SAYS "ANY NEXT COMMAND ABOVE", NEVER "BECAUSE NEXT COMMANDS NAME
	# FILES IN IT". The clone is kept whenever the doctor RAN, and the doctor
	# can refuse (exit 3: a missing <path>, a `--placement-plan` it cannot
	# write) with no report and no NEXT line at all; the first wording said
	# there were NEXT commands where there were none (#500, review of
	# 9808aec, SHOULD-1). Whether the clone is kept does not change, only
	# what the line claims about it.
	#
	# IT NAMES THE DIRECTORY AND HANDS OUT NO `rm`. Every other line here
	# that reads like a command is one to run; an agent told to run what the
	# report names would delete the clone before the commands it holds ran.
	if [ "$cloned" -eq 1 ]; then
		trap - EXIT
		kept="the standard this run used is kept at $WORKDIR, and any NEXT command above runs from it; it is safe to delete once you are done with them."
		if [ "$DOCTOR_JSON" -eq 1 ]; then
			say "$kept" >&2
		else
			say "$kept"
		fi
	fi
	return "$STATUS"
}

# --- arguments ------------------------------------------------------------
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help) usage; exit 0 ;;
	--version) refuse_bad_record; say "openRepoShape ($REPO @ $REF)"; exit 0 ;;
	# TWO MODES IS A REFUSAL, NEVER LAST-WINS. `--doctor <path> --install`
	# used to enter the install path and silently drop the diagnosis, and
	# the other order dropped the install (Copilot, PR #96). Each of these
	# does a different thing to a different place; a person who typed both
	# meant one of them, and quietly picking is how they find out later.
	--install) set_mode install; shift ;;
	# `--doctor [<path>]`: the REPOSITORY diagnosis. The optional path is
	# eaten here rather than passed on, because it is a positional and
	# would otherwise be taken for the <Project> a scaffold run names. A
	# word beginning with a dash is NOT the path -- it is a flag, and the
	# two below are the only ones this mode takes.
	--doctor)
		set_mode doctor; shift
		if [ $# -gt 0 ]; then
			case "$1" in
			-*) ;;
			*) DOCTOR_PATH="$1"; DOCTOR_PATH_GIVEN=1; shift ;;
			esac
		fi
		;;
	# `shape-doctor.py`'s TWO FLAGS, HANDED ON (#500). AGENTS.md's doctor
	# steps use both -- `--json` to act on a row by its id, `--placement-plan
	# <file>` as the `placement` row's own NEXT -- and the installed form
	# refused them, so a person who held no checkout could ask for neither.
	#
	# THEY ARE THE DOCTOR'S ONLY AFTER `--doctor`, the way a subcommand's
	# flags follow the subcommand. Typed anywhere else they are what they
	# always were, a lone flag passed on to setup.sh, which refuses both as
	# unknown: a scaffold run reads these words exactly as it did before.
	#
	# `--placement-plan=<file>` IS WHAT REACHES THE DOCTOR, whichever way it
	# was typed, so a <file> beginning with `-` is still a file to argparse.
	# The separate word is refused when it begins with `-`, as argparse
	# refuses it, so `--placement-plan --json` is not a plan written to a
	# file called `--json`; the `=` form is the way to name such a file.
	--json | --placement-plan | --placement-plan=*)
		if [ "$MODE" != "doctor" ]; then
			PASSTHROUGH+=("$1"); shift
		elif [ "$1" = "--json" ]; then
			DOCTOR_ARGS+=(--json); DOCTOR_JSON=1; shift
		else
			case "$1" in
			--placement-plan=*) PLAN_FILE="${1#--placement-plan=}"; shift ;;
			*)
				PLAN_FILE="${2-}"; shift
				case "$PLAN_FILE" in
				-*) PLAN_FILE="" ;;
				*) [ $# -eq 0 ] || shift ;;
				esac
				;;
			esac
			[ -n "$PLAN_FILE" ] ||
				die "--placement-plan needs the file to write the plan to: --placement-plan <file>, or --placement-plan=<file> for a name that begins with '-'."
			DOCTOR_ARGS+=("--placement-plan=$PLAN_FILE")
		fi
		;;
	# NAMED, THOUGH `-*` BELOW WOULD ALREADY PASS IT ON. The case exists
	# for the VARIABLE, not for the passing on: `--preflight` examines the
	# machine and stops, so the organisation and the <Project> this command
	# insists on further down — both of them about a run that would CREATE
	# something — are skipped rather than asked for.
	#
	# THE FLAG WAS `--doctor` UNTIL 2026-09-10 (#59/#62 -> #95). Brett Heap,
	# in session: "lets use doctor for this, it is better fit. use preflight
	# for the preflight." The machine check IS a preflight — it is the run's
	# own section (1) and nothing else — and `--doctor` was wanted for the
	# thing a person actually calls a doctor: a diagnosis of a REPOSITORY. So
	# this one took the name that always described it.
	--preflight) PREFLIGHT=1; PASSTHROUGH+=("$1"); shift ;;
	--org) ORG="${2:?--org needs a value}"; shift 2 ;;
	--project) PROJECT="${2:?--project needs a value}"; shift 2 ;;
	# setup.sh's value-taking flags, named so their VALUE is never mistaken
	# for the positional <Project>. Anything else beginning with a dash is a
	# lone flag and travels as-is: setup.sh refuses what it does not know, so
	# a flag is never learned twice.
	--id | --name | --visibility | --elected-by | --family | --into | --local-remote-dir | --shape-ref)
		PASSTHROUGH+=("$1" "${2:?$1 needs a value}"); shift 2 ;;
	--) shift; PASSTHROUGH+=(-- "$@"); break ;;
	-*) PASSTHROUGH+=("$1"); shift ;;
	*)
		# AFTER `--doctor` AND ITS FLAGS, THE ONE PATH IT HAS NOT YET HAD:
		# `--doctor --json ../Atlas` is the same run as `--doctor ../Atlas
		# --json` (#500). A word before `--doctor`, or a second path, is
		# still a <Project>, and the doctor refuses it below as before.
		if [ "$MODE" = "doctor" ] && [ "$DOCTOR_PATH_GIVEN" -eq 0 ]; then
			DOCTOR_PATH="$1"; DOCTOR_PATH_GIVEN=1; shift; continue
		fi
		[ -z "$PROJECT" ] || die "two project names, '$PROJECT' and '$1'. One positional <Project>, then flags."
		PROJECT="$1"; shift ;;
	esac
done

# A BROKEN RECORD IS REFUSED HERE, after `--help` has had its chance and
# before any run that would use the ref it should have named (#564).
refuse_bad_record

if [ "$MODE" = "doctor" ]; then
	# ONE PATH AND THE DOCTOR'S TWO FLAGS, NOTHING ELSE. Every other
	# argument this command knows is about a run that CREATES something, and
	# silently ignoring one typed alongside `--doctor` would answer a
	# question nobody asked. `--json` and `--placement-plan` were refused
	# here too until #500, while the mode was one path wide; they are
	# `shape-doctor.py`'s own, and are handed on above.
	[ -z "$PROJECT" ] && [ -z "$ORG" ] && [ ${#PASSTHROUGH[@]} -eq 0 ] ||
		die "--doctor takes a path, --json and --placement-plan <file>, and nothing else; it reads a repository and writes nothing into it.
    openRepoShape --doctor [<path>] [--json] [--placement-plan <file>]
    To scaffold, drop --doctor. To check this machine, run: openRepoShape --preflight"
	set +e
	run_doctor
	STATUS=$?
	set -e
	exit "$STATUS"
fi

if [ "$MODE" = "install" ]; then
	[ -z "$PROJECT" ] && [ ${#PASSTHROUGH[@]} -eq 0 ] ||
		die "--install takes no other arguments; it only installs the commands."
	install_commands
	exit 0
fi

# A BARE RUN HAS NOTHING TO DO, so it says what this command does and stops.
# It used to fall through into the scaffold path and refuse "no organisation
# to scaffold into" -- an answer about a run the person had not asked for, and
# the least useful of the four things this command can do. `--help` still
# exits 0, because asking is not a mistake; this exit is 1, because typing a
# command with no arguments and getting a page of text is.
#
# ANY SCAFFOLD ARGUMENT AT ALL KEEPS TODAY'S BEHAVIOUR, refusals included: a
# person who typed something meant something, and a usage page in place of the
# refusal they earned would hide which of their arguments was the problem.
if [ "$MODE" = "run" ] && [ "$PREFLIGHT" -eq 0 ] && [ -z "$PROJECT" ] &&
	[ -z "$ORG" ] && [ ${#PASSTHROUGH[@]} -eq 0 ]; then
	usage
	exit 1
fi

# NEVER a default organisation. setup.sh refuses `--org opensoft` without
# --allow-upstream-org for the same reason a guess is refused here: a wrong
# answer creates three repositories in somebody else's namespace. So: no
# guess, and --allow-upstream-org passed for nobody.
#
# BOTH REFUSALS BELOW ARE ABOUT CREATING SOMETHING, so `--preflight` skips
# both: it examines the machine and stops, and asking a person which
# organisation they meant before telling them their machine has no git would
# be a question with nothing behind it.
if [ "$PREFLIGHT" -eq 0 ]; then
	[ -n "$ORG" ] || ORG="${OPENREPOSHAPE_ORG:-}"
	if [ -z "$ORG" ] && [ -t 0 ]; then
		printf 'organisation to scaffold into: '
		read -r ORG || true
	fi
	[ -n "$ORG" ] || die "no organisation to scaffold into. Re-run with --org <your-org>, or set \$OPENREPOSHAPE_ORG."

	# setup.sh prompts for a missing project when a terminal is attached;
	# with no terminal it cannot, so say so before fetching a script to be
	# refused by.
	if [ -z "$PROJECT" ] && [ ! -t 0 ]; then
		usage >&2
		die "no <Project> given, and no terminal to ask on."
	fi
fi

# An --org typed alongside --preflight is still forwarded rather than dropped
# — the preflight ignores it, and a flag this command ATE would be a flag the
# person has to type twice to find out about. Outside --preflight the block
# above has already made $ORG non-empty or died, so this is what it always
# was.
ARGS=()
[ -z "$ORG" ] || ARGS+=(--org "$ORG")
[ -z "$PROJECT" ] || ARGS+=(--project "$PROJECT")
# Fetched at $REF, so setup.sh self-bootstraps its checkout at $REF too:
# otherwise the script that runs and the standard it clones are two commits.
# Whenever the ref was NAMED, by the variable or by the record (#564).
[ "$REF_NAMED" -eq 0 ] || ARGS+=(--shape-ref "$REF")
ARGS+=(${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"})

# $OPENREPOSHAPE_SETUP_SH is the OFFLINE TEST PATH: a setup.sh already on disk
# instead of a fetched one. It runs where it lies, so setup.sh finds its own
# checkout around it and clones nothing.
if [ -n "${OPENREPOSHAPE_SETUP_SH:-}" ]; then
	SETUP="$OPENREPOSHAPE_SETUP_SH"
	[ -f "$SETUP" ] || die "\$OPENREPOSHAPE_SETUP_SH is '$SETUP', which is not a file."
else
	workdir
	SETUP="$WORKDIR/setup.sh"
	fetch_or_die setup.sh "$SETUP"
fi

# Run the script as a FILE rather than `bash -s --` from a pipe: setup.sh ASKS
# — for the project name when it was not given, and for the one `yes` before
# three repositories exist — and a script arriving on stdin is a script whose
# stdin is not the terminal the person is typing at.
export OPENREPOSHAPE_REPO="$(shape_clone_url)"
set +e
# `${ARGS[@]+...}`, the same guard $PASSTHROUGH gets above. $ARGS is no longer
# seeded with `--org` unconditionally, so an empty array is reachable here in
# principle — and under `set -u` bash 3.2, the /bin/bash on every Mac, treats
# an empty array's `"${ARGS[@]}"` as an unbound variable rather than as
# nothing at all.
bash "$SETUP" ${ARGS[@]+"${ARGS[@]}"}
STATUS=$?
set -e
exit "$STATUS"
